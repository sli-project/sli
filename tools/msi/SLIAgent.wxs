<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="SLI Agent" Language="1033" Version="$(var.ProductVersion)"
           Manufacturer="SLI" UpgradeCode="D6836D37-49FA-4AB6-BDFD-10B07ED51973">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <MediaTemplate EmbedCab="yes" />
    <!-- Related packages skip cleanup during RemoveExistingProducts. Keep the
         protected state in place and validate it before starting the service. -->
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="no"
                  DowngradeErrorMessage="SLI Agent requires a newer build." />
    <Property Id="WINDOWS_BUILD">
      <RegistrySearch Id="WindowsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Win64="yes" />
    </Property>
    <Condition Message="SLI Agent requires 64-bit Windows 10 / Windows Server 2016 or later.">VersionNT64 AND WINDOWS_BUILD &gt;= 14393</Condition>
    <Condition Message="Run SLI Agent installation from an elevated administrator session or a SYSTEM deployment job.">Privileged</Condition>
    <Condition Message="Supply SERVER_URL and either CA_FILE or CA_FINGERPRINT. Enrollment uses a protected TOKEN_FILE path, never a token property.">Installed OR WIX_UPGRADE_DETECTED OR RESTORE_STATE OR (SERVER_URL AND (CA_FILE OR CA_FINGERPRINT))</Condition>
    <Property Id="SERVER_URL" Secure="yes" />
    <Property Id="CA_FILE" Secure="yes" />
    <Property Id="CA_FINGERPRINT" Secure="yes" />
    <Property Id="TOKEN_FILE" Secure="yes" />
    <Property Id="SERVICE_ACCOUNT" Value="LocalSystem" Secure="yes" />
    <Property Id="RESTORE_STATE" Secure="yes" />
    <Property Id="PRESERVE_STATE" Secure="yes" />
    <Property Id="STORED_SERVICE_ACCOUNT" Secure="yes">
      <RegistrySearch Id="StoredAccount" Root="HKLM" Key="SOFTWARE\SLI\Agent" Name="ServiceAccount" Type="raw" Win64="yes" />
    </Property>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="SLIFOLDER" Name="SLI">
          <Directory Id="INSTALLFOLDER" Name="Agent">
            <Component Id="AgentService" Guid="8AA192A3-BA74-49B6-9A77-973E64911F01" Win64="yes">
              <File Id="AgentPython" Source="$(var.PayloadRoot)\python.exe" KeyPath="yes" />
              <RegistryValue Root="HKLM" Key="SOFTWARE\SLI\Agent" Name="ServiceAccount" Type="string" Value="[SERVICE_ACCOUNT]" />
              <RegistryValue Root="HKLM" Key="SOFTWARE\SLI\Agent" Name="ProductCode" Type="string" Value="[ProductCode]" />
              <ServiceInstall Id="AgentServiceInstall" Name="SLIAgent" DisplayName="SLI Agent"
                Description="Outbound SLI agent; collection requires enrollment and assigned policy."
                Type="ownProcess" Start="auto" ErrorControl="normal" Account="[SERVICE_ACCOUNT]"
                Arguments="-I -B -m sli_agent.service" Vital="yes" />
              <ServiceControl Id="AgentServiceControl" Name="SLIAgent" Start="install"
                Stop="both" Remove="uninstall" Wait="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </Directory>
    <Binary Id="AgentCustomAction" SourceFile="$(var.CustomActionDll)" />
    <CustomAction Id="PrepareAgent" BinaryKey="AgentCustomAction" DllEntry="PrepareAgent" Execute="immediate" Return="check" />
    <CustomAction Id="ConfigureAgent" BinaryKey="AgentCustomAction" DllEntry="RunAgent" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="RestoreAgent" BinaryKey="AgentCustomAction" DllEntry="RunAgent" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="PreserveAgent" BinaryKey="AgentCustomAction" DllEntry="RunAgent" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="RemoveAgent" BinaryKey="AgentCustomAction" DllEntry="RunAgent" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="RollbackAgent" BinaryKey="AgentCustomAction" DllEntry="RunAgent" Execute="rollback" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="CommitAgent" BinaryKey="AgentCustomAction" DllEntry="RunAgent" Execute="commit" Impersonate="no" Return="check" HideTarget="yes" />
    <InstallExecuteSequence>
      <Custom Action="PrepareAgent" Before="InstallInitialize">1</Custom>
      <Custom Action="RollbackAgent" After="InstallFiles">NOT Installed AND NOT RESTORE_STATE AND NOT WIX_UPGRADE_DETECTED</Custom>
      <Custom Action="ConfigureAgent" After="RollbackAgent">NOT Installed AND NOT RESTORE_STATE AND NOT WIX_UPGRADE_DETECTED</Custom>
      <Custom Action="RestoreAgent" After="ConfigureAgent">NOT Installed AND RESTORE_STATE</Custom>
      <Custom Action="PreserveAgent" After="RestoreAgent">NOT Installed AND WIX_UPGRADE_DETECTED AND NOT RESTORE_STATE</Custom>
      <Custom Action="CommitAgent" After="PreserveAgent">NOT Installed AND NOT RESTORE_STATE AND NOT WIX_UPGRADE_DETECTED</Custom>
      <Custom Action="RemoveAgent" After="DeleteServices">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND NOT PRESERVE_STATE</Custom>
    </InstallExecuteSequence>
    <Feature Id="Agent" Title="SLI Agent" Level="1" Absent="disallow">
      <ComponentRef Id="AgentService" />
      <ComponentGroupRef Id="AgentPayload" />
    </Feature>
  </Product>
</Wix>
