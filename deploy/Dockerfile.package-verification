# Synthetic package verification only; not a SLI runtime/Windows acceptance image.
FROM python:3.14.7-slim@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d
RUN pip install --no-cache-dir cryptography==50.0.1 cffi==2.1.0 pytest==8.4.2
WORKDIR /work
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY server/sli/release_package.py ./server/sli/
COPY scripts/maintenance/release_package.py scripts/maintenance/apply_update.py scripts/maintenance/rollback_update.py scripts/maintenance/bundle_common.py ./scripts/maintenance/
COPY scripts/package_project.py scripts/apply_project_zip.py scripts/package_admin_toolkit.py scripts/run_dc_log_pilot.py ./scripts/
COPY scripts/manual_dc_audit ./scripts/manual_dc_audit/
COPY scripts/dc_client ./scripts/dc_client/
COPY frontend/package.json ./frontend/
COPY frontend/src/main.tsx ./frontend/src/
COPY package.json package-lock.json requirements.lock.txt ./
COPY tests/tooling/test_release_package.py tests/tooling/test_security_packaging_boundary.py tests/tooling/test_update_safety_contract.py ./tests/tooling/
USER 65534:65534
CMD ["python", "-m", "pytest", "-p", "no:cacheprovider", "--basetemp=/tmp/sli-package-tests", "-q", "tests/tooling/test_release_package.py", "tests/tooling/test_security_packaging_boundary.py", "tests/tooling/test_update_safety_contract.py"]
