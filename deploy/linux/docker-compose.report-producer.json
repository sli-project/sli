{
  "services": {
    "postgres": {
      "networks": ["default", "report-db"]
    },
    "report-producer": {
      "profiles": ["report-producer"],
      "image": "sli-linux-stand:local",
      "pull_policy": "never",
      "entrypoint": ["python", "-m", "server.sli.core.report_schedule_producer"],
      "command": [],
      "user": "10001:10001",
      "restart": "unless-stopped",
      "read_only": true,
      "tmpfs": ["/tmp:mode=1777"],
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "mem_limit": "256m",
      "cpus": "0.5",
      "pids_limit": 32,
      "stop_grace_period": "30s",
      "environment": {
        "SLI_REPORT_PRODUCER_PG_DSN": "host=postgres port=5432 dbname=sli user=sli_report_producer_login",
        "SLI_REPORT_PRODUCER_PG_PASSWORD_FILE": "/run/secrets/report_producer_password"
      },
      "secrets": ["report_producer_password"],
      "networks": ["report-db"],
      "depends_on": {
        "postgres": {"condition": "service_healthy"},
        "migrate": {"condition": "service_completed_successfully"}
      },
      "healthcheck": {
        "test": ["CMD", "python", "-m", "server.sli.core.report_schedule_producer", "--health"],
        "interval": "15s",
        "timeout": "5s",
        "retries": 4,
        "start_period": "30s"
      }
    }
  },
  "networks": {
    "default": {},
    "report-db": {"internal": true}
  },
  "secrets": {
    "report_producer_password": {
      "file": "${SLI_REPORT_PRODUCER_PASSWORD_SOURCE:?Set separately approved absolute producer password-file path}"
    }
  }
}
