#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

fail() {
    printf 'SLI beta kit: %s\n' "$1" >&2
    exit 1
}

cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
[[ -f SHA256SUMS && ! -L SHA256SUMS ]] || fail 'SHA256SUMS must be a regular file'

entry='^[a-f0-9]{64}  ([A-Za-z0-9][A-Za-z0-9.+_~-]*)$'
deb='^[A-Za-z0-9][A-Za-z0-9.+_~-]*\.deb$'
declare -A listed=()
files=() packages=() checksums=()
while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ $entry ]] || fail 'Invalid SHA256SUMS entry'
    name=${BASH_REMATCH[1]}
    [[ ! ${listed[$name]+present} ]] || fail "Duplicate entry: $name"
    [[ -f $name && ! -L $name ]] || fail "Missing or unsafe file: $name"
    case $name in
        *.deb) packages+=("./$name") ;;
        manifest.json|install-beta-kit|remove-beta-kit) ;;
        *) fail "Unexpected entry: $name" ;;
    esac
    listed[$name]=1
    files+=("$name")
    checksums+=("$line")
done < SHA256SUMS
[[ ${listed[manifest.json]+present} && ${listed[install-beta-kit]+present} && ${#packages[@]} -gt 0 ]] \
    || fail 'SHA256SUMS must include the kit manifest, installer and packages'

shopt -s nullglob dotglob
for name in *.deb; do
    [[ $name =~ $deb && ${listed[$name]+present} ]] || fail "Unlisted package: $name"
done

# Verify the bytes in the same private directory that APT will read.
staging=$(mktemp -d --tmpdir=/tmp sli-beta-install.XXXXXXXX)
trap 'rm -rf -- "$staging"' EXIT
install -m 0644 -- "${files[@]}" "$staging/"
cd -- "$staging"
printf '%s\n' "${checksums[@]}" | sha256sum --check --strict --status - || fail 'SHA-256 verification failed'
chmod 0755 -- "$staging"

install=() releases=()
target_version=
host_package=
host_version=
release_package=
upgrade=
for file in "${packages[@]}"; do
    package=$(dpkg-deb -f "$file" Package)
    version=$(dpkg-deb -f "$file" Version)
    arch=$(dpkg-deb -f "$file" Architecture)
    [[ $package =~ ^[a-z0-9][a-z0-9+.-]+$ && $arch =~ ^[a-z0-9]+$ && -n $version ]] \
        || fail "Invalid Debian package metadata: $file"
    case $package in
        sli)
            [[ -z $target_version ]] || fail 'Multiple sli packages in the kit'
            target_version=$version ;;
        sli-host)
            [[ -z $host_package ]] || fail 'Multiple sli-host packages in the kit'
            host_package=$file
            host_version=$version ;;
        sli-release-*)
            # Kits can also carry a retained release. Select the candidate
            # after reading the public package version below.
            releases+=("$file") ;;
        sli-*) ;;
        *)
            query=$package
            [[ $arch == all ]] || query+=":$arch"
            if entry=$(dpkg-query -W -f='${db:Status-Status} ${Version}' "$query" 2>/dev/null); then
                read -r status installed <<< "$entry"
                case $status in
                    installed|unpacked|half-installed|half-configured|triggers-awaited|triggers-pending)
                        if dpkg --compare-versions "$installed" gt "$version"; then
                            printf 'Keeping %s %s (kit version %s)\n' "$query" "$installed" "$version"
                            continue
                        fi ;;
                esac
            fi ;;
    esac
    install+=("$file")
done
[[ ${#install[@]} -gt 0 ]] || fail 'No packages to install'

# An existing installation must admit the checkpoint before APT can stop it.
# Extract the verified candidate helpers without executing any maintainer scripts.
if [[ -n $target_version ]]; then
    host_status=$(dpkg-query -W -f='${db:Status-Status}' sli-host 2>/dev/null) || host_status=
    if [[ $host_status == installed || -L /opt/sli/current || -e /opt/sli/current ]]; then
        upgrade=1
        [[ -n $host_package && $host_version == "$target_version" ]] || fail 'Missing matching sli-host package'
        mkdir -p -- preflight/deploy
        dpkg-deb --extract "$host_package" preflight/package
        mv -- preflight/package/usr/lib/sli preflight/deploy/linux
        for file in "${releases[@]}"; do
            release_version=$(dpkg-deb -f "$file" Version)
            if [[ $release_version == "$target_version" ]]; then
                [[ -z $release_package ]] || fail 'Multiple candidate release packages in the kit'
                release_package=$file
            fi
        done
        [[ -n $release_package ]] || fail 'Missing candidate release package'
        sudo /usr/bin/python3 -I -B "$staging/preflight/deploy/linux/native_upgrade.py" \
            check-package-space "$target_version" "$release_package"
    fi
fi

sudo apt-get update
sudo env DEBIAN_FRONTEND=noninteractive apt-get --assume-yes \
    -o APT::Get::allow-Downgrades=false \
    -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
    install --no-remove --fix-broken "${install[@]}"
sudo /usr/sbin/sli-setup "$@"

# Package activation runs under APT. Purge only after APT and setup have exited.
if [[ -n $upgrade ]]; then
    sudo /usr/sbin/sli-native-upgrade purge-old-release-packages "$target_version" ||
        printf 'native_upgrade_release_purge_warning: Could not start package cleanup\n' >&2
fi
