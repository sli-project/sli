<clickhouse>
    <!-- Production warm tier is not a diagnostic trace collector. -->
    <logger>
        <level>warning</level>
        <size>100M</size>
        <count>3</count>
    </logger>
    <total_memory_profiler_step>0</total_memory_profiler_step>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_metric_log remove="1"/>
    <query_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </part_log>
    <error_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </error_log>
    <metric_log>
        <collect_interval_milliseconds>60000</collect_interval_milliseconds>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </metric_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </asynchronous_metric_log>
</clickhouse>
