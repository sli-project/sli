{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SLI bundled plugin settings metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plugin_id",
    "name",
    "settings",
    "rules",
    "permissions",
    "migration_directory"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plugin_id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "$ref": "#/$defs/message_key"
    },
    "settings": {
      "$ref": "#/$defs/package_settings"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package_rule"
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "migration_directory": {
      "type": "string",
      "pattern": "^config/(?:[a-z0-9_-]+/)*[a-z0-9_-]+$"
    }
  },
  "$defs": {
    "package_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "type",
        "properties",
        "required",
        "additionalProperties",
        "x-core-settings"
      ],
      "properties": {
        "$schema": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "type": {
          "const": "object"
        },
        "additionalProperties": {
          "const": false
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/setting"
          }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "x-core-settings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "default",
        "x-label",
        "x-help",
        "x-group",
        "x-secret"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/setting_type"
        },
        "default": {},
        "minimum": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "pattern": {
          "type": "string"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {}
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "uniqueItems": {
          "type": "boolean"
        },
        "items": {
          "$ref": "#/$defs/setting_value_schema"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/setting_value_schema"
          }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "const": false
        },
        "x-label": {
          "$ref": "#/$defs/message_key"
        },
        "x-help": {
          "$ref": "#/$defs/message_key"
        },
        "x-group": {
          "enum": [
            "basic",
            "advanced"
          ]
        },
        "x-secret": {
          "type": "boolean"
        }
      }
    },
    "setting_type": {
      "oneOf": [
        {
          "enum": [
            "string",
            "integer",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "string",
              "integer",
              "boolean",
              "object",
              "array",
              "null"
            ]
          }
        }
      ]
    },
    "setting_value_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/setting_type"
        },
        "default": {},
        "minimum": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "pattern": {
          "type": "string"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {}
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "uniqueItems": {
          "type": "boolean"
        },
        "items": {
          "$ref": "#/$defs/setting_value_schema"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/setting_value_schema"
          }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "const": false
        },
        "oneOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/setting_value_schema"
          }
        }
      }
    },
    "package_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "name",
        "settings",
        "core_settings"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
        },
        "name": {
          "$ref": "#/$defs/message_key"
        },
        "settings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "core_settings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "message_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^plugins\\.[a-zA-Z0-9_.-]+$"
    }
  }
}
