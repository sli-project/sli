{
  "schema_version": 1,
  "contract_id": "sli.plugin-worker-credentials.v1",
  "status": "prepared_fixture_only",
  "architecture_decision_id": "sli.plugin-architecture.v2",
  "runtime_enabled": false,
  "autostart_enabled": false,
  "source_contact_allowed": false,
  "production_secret_store_changed": false,
  "live_backend_implemented": false,
  "lease": {
    "max_ttl_seconds": 900,
    "max_environment_names": 8,
    "new_lease_requires_active_generation": true,
    "rotation_requires_next_generation": true,
    "old_generation_existing_lease_may_drain_until_expiry": true,
    "expired_or_revoked_lease_fails_closed": true
  },
  "exact_binding_fields": [
    "plugin_id",
    "component_id",
    "source_instance_id",
    "credential_generation",
    "handler_sha256"
  ],
  "allowed_scopes": {
    "source_read": [
      "SLI_PLUGIN_SOURCE_CREDENTIAL"
    ],
    "plugin_postgres": [
      "SLI_PLUGIN_PG_DSN"
    ]
  },
  "prohibited_environment_names": [
    "ADLOG_PG_DSN",
    "ADLOG_PG_ADMIN_USER",
    "ADLOG_PG_ADMIN_PASSWORD"
  ],
  "materialization": {
    "target": "exact_allowlisted_child_process_environment_only",
    "parent_environment_inheritance": false,
    "raw_value_persistence": false,
    "raw_value_logging": false,
    "raw_value_in_evidence": false
  },
  "audit_fields": [
    "lease_id",
    "handle_id",
    "plugin_id",
    "component_id",
    "source_instance_id",
    "credential_generation",
    "scope",
    "worker_instance_id",
    "runtime_instance_id",
    "environment_names",
    "issued_at_epoch_seconds",
    "expires_at_epoch_seconds",
    "outcome"
  ],
  "source_identity": {
    "includes": [
      "plugin_id",
      "component_id",
      "source_instance_id"
    ],
    "excludes": [
      "credential_generation",
      "worker_instance_id",
      "runtime_instance_id"
    ]
  },
  "explicitly_out_of_scope": [
    "windows_dpapi_provisioning",
    "real_secret_read_or_write",
    "worker_process_spawn",
    "firewall_or_network_change",
    "postgres_role_or_schema_change",
    "source_contact",
    "runtime_activation",
    "autostart"
  ]
}
