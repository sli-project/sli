        "normal_resource_profile_id": null,
        "normal_resource_profile_proven": false
      },
      "source_preconditions": {
        "dedicated_read_only_share_configured": true,
        "static_timezone_descriptor_replaces_remote_registry": true,
        "timezone_drift_check_accepted": false,
        "timezone_owner_assumption_active": true
      }
    },
    {
