{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": 3,
  "decision_id": "sli.plugin-architecture.v3",
  "supersedes": "sli.plugin-architecture.v2",
  "status": "proposed",
  "title": "SLI plugin manifest v3 (proposed)",
  "$comment": "Schema only. No package registration, runtime admission or migration execution. See docs/adr/ADR-0022-core-and-plugins-v3.md. Cross-field compatibility, uniqueness, rights and lease fencing require core validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "architecture_decision_id", "plugin_id", "plugin_version", "core_api", "trust", "own_permanent_workers", "capabilities", "dependencies", "sources", "agent_modules", "handlers", "schedules", "datasets", "reports", "navigation", "home_widgets", "data"],
  "properties": {
    "schema_version": {"const": 3},
    "architecture_decision_id": {"const": "sli.plugin-architecture.v3"},
    "plugin_id": {"$ref": "#/$defs/id"},
    "plugin_version": {"$ref": "#/$defs/semver"},
    "core_api": {"$ref": "#/$defs/version_range"},
    "trust": {"const": "bundled_reviewed_only"},
    "own_permanent_workers": {"const": false},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "agent_modules": {"type": "array", "items": {"$ref": "#/$defs/agent_module"}},
    "handlers": {"type": "array", "items": {"$ref": "#/$defs/handler"}},
    "schedules": {"type": "array", "items": {"$ref": "#/$defs/schedule"}},
    "datasets": {"type": "array", "items": {"$ref": "#/$defs/dataset"}},
    "reports": {"type": "array", "items": {"$ref": "#/$defs/report"}},
    "navigation": {"type": "array", "items": {"$ref": "#/$defs/section"}},
    "home_widgets": {"type": "array", "items": {"$ref": "#/$defs/widget"}},
    "data": {"$ref": "#/$defs/data"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_.-]*$"},
    "opaque_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "version_range": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum", "maximum_exclusive"],
      "properties": {"minimum": {"$ref": "#/$defs/semver"}, "maximum_exclusive": {"$ref": "#/$defs/semver"}}
    },
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "versions", "required", "exchange"],
      "properties": {
        "contract_id": {"$ref": "#/$defs/id"}, "versions": {"$ref": "#/$defs/version_range"},
        "required": {"type": "boolean"}, "exchange": {"const": "immutable_typed_result"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["pack_id", "pack_version", "normalizer_id", "normalizer_version", "input_contract", "catalog_ref", "collection_policy_schema_ref"],
      "properties": {
        "pack_id": {"$ref": "#/$defs/id"}, "pack_version": {"$ref": "#/$defs/semver"},
        "normalizer_id": {"$ref": "#/$defs/id"}, "normalizer_version": {"$ref": "#/$defs/semver"},
        "input_contract": {"$ref": "#/$defs/id"}, "catalog_ref": {"$ref": "#/$defs/id"},
        "collection_policy_schema_ref": {"$ref": "#/$defs/id"}
      }
    },
    "agent_module": {
      "type": "object", "additionalProperties": false,
      "required": ["module_id", "module_version", "agent_api", "capabilities", "rights_check_id", "policy_schema_ref"],
      "properties": {
        "module_id": {"$ref": "#/$defs/id"}, "module_version": {"$ref": "#/$defs/semver"},
        "agent_api": {"$ref": "#/$defs/version_range"},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "rights_check_id": {"$ref": "#/$defs/id"}, "policy_schema_ref": {"$ref": "#/$defs/id"}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["wall_seconds", "cpu_seconds", "memory_bytes", "max_records", "max_result_bytes", "max_db_connections", "statement_timeout_ms", "lock_timeout_ms"],
      "properties": {
        "wall_seconds": {"type": "integer", "minimum": 1}, "cpu_seconds": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1}, "max_records": {"type": "integer", "minimum": 1},
        "max_result_bytes": {"type": "integer", "minimum": 1}, "max_db_connections": {"type": "integer", "minimum": 1},
        "statement_timeout_ms": {"type": "integer", "minimum": 1}, "lock_timeout_ms": {"type": "integer", "minimum": 1}
      }
    },
    "handler": {
      "type": "object", "additionalProperties": false,
      "required": ["handler_id", "handler_version", "kind", "input_contract", "result_contract", "resource_profile", "rights_profile", "budget", "max_attempts"],
      "properties": {
        "handler_id": {"$ref": "#/$defs/id"}, "handler_version": {"$ref": "#/$defs/semver"},
        "kind": {"enum": ["acquire", "normalize", "project", "correlate", "snapshot", "reconcile"]},
        "input_contract": {"$ref": "#/$defs/id"}, "result_contract": {"$ref": "#/$defs/id"},
        "resource_profile": {"$ref": "#/$defs/id"}, "rights_profile": {"$ref": "#/$defs/id"},
        "budget": {"$ref": "#/$defs/budget"}, "max_attempts": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "schedule": {
      "type": "object", "additionalProperties": false,
      "required": ["schedule_id", "handler_id", "trigger", "interval_seconds", "calendar", "timezone", "max_inflight_per_source"],
      "properties": {
        "schedule_id": {"$ref": "#/$defs/id"}, "handler_id": {"$ref": "#/$defs/id"},
        "trigger": {"enum": ["interval", "calendar", "input_available"]}, "interval_seconds": {"type": ["integer", "null"], "minimum": 1},
        "calendar": {"oneOf": [{"$ref": "#/$defs/schedule_calendar"}, {"type": "null"}]},
        "timezone": {"type": "string", "minLength": 1}, "max_inflight_per_source": {"type": "integer", "minimum": 1}
      }
    },
    "schedule_calendar": {
      "type": "object", "additionalProperties": false,
      "required": ["local_times"],
      "properties": {
        "local_times": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}}
      }
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_id", "contract_id", "contract_version", "reader_id", "capabilities"],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/id"}, "contract_id": {"$ref": "#/$defs/id"},
        "contract_version": {"$ref": "#/$defs/semver"}, "reader_id": {"$ref": "#/$defs/id"},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["report_key", "access_key", "dataset_id", "definition_id", "section_id", "title_key", "routes", "required_fields", "capabilities", "history_reader_id"],
      "properties": {
        "report_key": {"$ref": "#/$defs/id"}, "access_key": {"$ref": "#/$defs/id"},
        "dataset_id": {"$ref": "#/$defs/id"}, "definition_id": {"$ref": "#/$defs/id"},
        "section_id": {"$ref": "#/$defs/id"}, "title_key": {"$ref": "#/$defs/id"},
        "routes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
        "required_fields": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "history_reader_id": {"$ref": "#/$defs/id"}
      }
    },
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["section_id", "title_key", "icon_id", "order", "parent_section_id"],
      "properties": {
        "section_id": {"$ref": "#/$defs/id"}, "title_key": {"$ref": "#/$defs/id"}, "icon_id": {"$ref": "#/$defs/id"},
        "order": {"type": "integer"}, "parent_section_id": {"type": ["string", "null"], "maxLength": 160}
      }
    },
    "widget": {
      "type": "object", "additionalProperties": false,
      "required": ["widget_id", "report_key", "view_key", "order"],
      "properties": {
        "widget_id": {"$ref": "#/$defs/id"}, "report_key": {"$ref": "#/$defs/id"},
        "view_key": {"$ref": "#/$defs/id"}, "order": {"type": "integer"}
      }
    },
    "migration": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "name", "path", "sha256", "core_prerequisites"],
      "properties": {
        "version": {"type": "integer", "minimum": 1}, "name": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "pattern": "^config/postgres_migrations/[0-9]+_[a-z0-9_]+\\.sql$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "core_prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "existing_tables", "migrations"],
      "properties": {
        "schema": {"type": "string", "pattern": "^sli_plugin_[a-z][a-z0-9_]*$"},
        "existing_tables": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"}},
        "migrations": {"type": "array", "items": {"$ref": "#/$defs/migration"}}
      }
    },
    "scope_clause": {
      "type": "object", "additionalProperties": false,
      "required": ["source_instance_ids", "device_ids", "entity_ids", "collection_scope_ids"],
      "properties": {
        "plugin_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "source_instance_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/opaque_id"}},
        "device_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/opaque_id"}},
        "entity_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "collection_scope_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/opaque_id"}}
      }
    },
    "access_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "clauses", "decision_id", "policy_revision"],
      "properties": {
        "mode": {"enum": ["none", "restricted", "all"]},
        "clauses": {"type": "array", "items": {"$ref": "#/$defs/scope_clause"}},
        "decision_id": {"$ref": "#/$defs/opaque_id"}, "policy_revision": {"$ref": "#/$defs/opaque_id"}
      }
    },
    "entity_identifier": {
      "type": "object", "additionalProperties": false,
      "required": ["namespace", "scope_id", "value", "strength"],
      "properties": {
        "namespace": {"$ref": "#/$defs/id"}, "scope_id": {"$ref": "#/$defs/opaque_id"},
        "value": {"$ref": "#/$defs/opaque_id"}, "strength": {"enum": ["stable", "alias"]}
      }
    },
    "entity_observation": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "kind", "source_instance_id", "observed_at_utc", "identifiers", "evidence_refs"],
      "properties": {
        "contract_id": {"const": "sli.entity-observation.v1"}, "kind": {"enum": ["principal", "device", "group"]},
        "source_instance_id": {"$ref": "#/$defs/opaque_id"}, "observed_at_utc": {"type": "string", "format": "date-time"},
        "identifiers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entity_identifier"}},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/opaque_id"}}
      }
    },
    "job": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "job_id", "plugin_id", "plugin_version", "manifest_sha256", "handler_id", "handler_version", "input_contract", "input_ref", "input_sha256", "source_instance_id", "partition_key", "idempotency_key", "access_scope", "resource_profile", "rights_profile", "budget", "priority", "max_attempts", "available_at_utc", "deadline_at_utc", "continuation"],
      "properties": {
        "contract_id": {"const": "sli.core-job.v1"}, "job_id": {"$ref": "#/$defs/opaque_id"},
        "plugin_id": {"$ref": "#/$defs/id"}, "plugin_version": {"$ref": "#/$defs/semver"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}, "handler_id": {"$ref": "#/$defs/id"},
        "handler_version": {"$ref": "#/$defs/semver"}, "input_contract": {"$ref": "#/$defs/id"},
        "input_ref": {"$ref": "#/$defs/opaque_id"}, "input_sha256": {"$ref": "#/$defs/sha256"},
        "source_instance_id": {"$ref": "#/$defs/opaque_id"}, "partition_key": {"$ref": "#/$defs/opaque_id"},
        "idempotency_key": {"$ref": "#/$defs/sha256"}, "access_scope": {"$ref": "#/$defs/access_scope"},
        "resource_profile": {"$ref": "#/$defs/id"}, "rights_profile": {"$ref": "#/$defs/id"},
        "budget": {"$ref": "#/$defs/budget"}, "priority": {"enum": ["security", "normal", "background"]},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 32},
        "available_at_utc": {"type": "string", "format": "date-time"}, "deadline_at_utc": {"type": "string", "format": "date-time"},
        "continuation": {"type": ["string", "null"], "maxLength": 4096}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "job_id", "lease_token", "lease_generation", "plugin_id", "plugin_version", "handler_id", "handler_version", "status", "output_contract", "output_refs", "evidence_refs", "result_sha256", "continuation", "coverage_state", "error_code"],
      "properties": {
        "contract_id": {"const": "sli.core-job-result.v1"}, "job_id": {"$ref": "#/$defs/opaque_id"},
        "lease_token": {"$ref": "#/$defs/opaque_id"}, "lease_generation": {"type": "integer", "minimum": 1},
        "plugin_id": {"$ref": "#/$defs/id"}, "plugin_version": {"$ref": "#/$defs/semver"},
        "handler_id": {"$ref": "#/$defs/id"}, "handler_version": {"$ref": "#/$defs/semver"},
        "status": {"enum": ["success", "partial", "retryable_error", "permanent_error", "blocked", "cancelled"]},
        "output_contract": {"$ref": "#/$defs/id"},
        "output_refs": {"type": "array", "items": {"$ref": "#/$defs/opaque_id"}},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/opaque_id"}},
        "result_sha256": {"$ref": "#/$defs/sha256"}, "continuation": {"type": ["string", "null"], "maxLength": 4096},
        "coverage_state": {"enum": ["complete", "partial", "not_proven", "not_collected", "blocked"]},
        "error_code": {"type": ["string", "null"], "maxLength": 160}
      }
    },
    "cursor": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "token"],
      "properties": {
        "strategy": {"enum": ["record_id", "bookmark", "file_offset", "snapshot"]},
        "token": {"type": "string", "maxLength": 4096}
      }
    },
    "agent_envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "packet_id", "agent_id", "source_instance_id", "module_id", "module_version", "policy_revision", "channel", "generation", "sequence", "cursor_before", "cursor_after", "payload_contract", "payload_sha256", "record_count", "payload_bytes", "observed_at_utc", "continuity_state", "filtered_count", "lost_count"],
      "properties": {
        "contract_id": {"const": "sli.agent-envelope.v1"}, "packet_id": {"$ref": "#/$defs/opaque_id"},
        "agent_id": {"$ref": "#/$defs/opaque_id"}, "source_instance_id": {"$ref": "#/$defs/opaque_id"},
        "module_id": {"$ref": "#/$defs/id"}, "module_version": {"$ref": "#/$defs/semver"},
        "policy_revision": {"$ref": "#/$defs/opaque_id"}, "channel": {"$ref": "#/$defs/opaque_id"},
        "generation": {"$ref": "#/$defs/opaque_id"}, "sequence": {"type": "integer", "minimum": 0},
        "cursor_before": {"$ref": "#/$defs/cursor"}, "cursor_after": {"$ref": "#/$defs/cursor"},
        "payload_contract": {"$ref": "#/$defs/id"}, "payload_sha256": {"$ref": "#/$defs/sha256"},
        "record_count": {"type": "integer", "minimum": 0}, "payload_bytes": {"type": "integer", "minimum": 0},
        "observed_at_utc": {"type": "string", "format": "date-time"},
        "continuity_state": {"enum": ["complete", "not_proven", "gap", "filtered"]},
        "filtered_count": {"type": "integer", "minimum": 0}, "lost_count": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "packet_id", "payload_sha256", "status", "committed_cursor", "evidence_ref", "committed_at_utc", "error_code"],
      "properties": {
        "contract_id": {"const": "sli.agent-receipt.v1"}, "packet_id": {"$ref": "#/$defs/opaque_id"},
        "payload_sha256": {"$ref": "#/$defs/sha256"}, "status": {"enum": ["committed", "duplicate", "rejected", "retry_later"]},
        "committed_cursor": {"oneOf": [{"$ref": "#/$defs/cursor"}, {"type": "null"}]},
        "evidence_ref": {"type": ["string", "null"], "maxLength": 512},
        "committed_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "error_code": {"type": ["string", "null"], "maxLength": 160}
      }
    }
  }
}
