# Safe local example. Copy to .env and replace values outside Git.
ADLOG_DB_BACKEND=postgres
ADLOG_PG_DSN=postgresql://example_user:example_password@127.0.0.1:5432/example_db
ADLOG_PG_CONNECT_TIMEOUT_SECONDS=3
ADLOG_PG_STATEMENT_TIMEOUT_MS=900000
ADLOG_PG_LOCK_TIMEOUT_MS=3000

# Authentication is required on every installation. Diagnostic opt-out and
# reverse proxy trust are described in docs/OPERATIONS_RUNBOOK.md.
ADLOG_AUTH_REQUIRED=1
ADLOG_ALLOW_UNAUTHENTICATED=0
ADLOG_TRUSTED_PROXIES=

# Report domain is read only from platform_settings (reports.domain_fqdn).
# Set it on /app/platform-settings. Linux bootstrap seeds it once from
# SLI_INSTALL_DOMAIN during bootstrap; runtime env cannot override it.

# Source contact and background collection are disabled by default.
# The in-process scheduler now stays off unless ADLOG_ENABLE_INPROCESS_COLLECTION_SCHEDULER=1
# is set explicitly (rollback/diagnostic only; never set it in production).
# ADLOG_DISABLE_SCHEDULER=1 below is kept as an additional explicit hard-off,
# not the thing making the default safe.
ADLOG_DISABLE_SCHEDULER=1
ADLOG_DISABLE_COLLECTION=1

# Post-collection: scripts/runtime/post_collection_worker.py is the sole
# production owner. The in-process ThreadPoolExecutor stays off unless
# ADLOG_ENABLE_INPROCESS_POST_COLLECTION=1 is set explicitly (dev-only
# convenience for running without a separate durable worker process; never
# set it in production).
ADLOG_ENABLE_INPROCESS_POST_COLLECTION=1
ADLOG_CONTINUOUS_RECOVERY=false
ADLOG_SECURITY_MAX_EVENTS=50000
ADLOG_SECURITY_RECOVERY_MAX_LIMIT=50000
ADLOG_COLLECTION_PREFLIGHT_SERVER=
ADLOG_RADIUS_COLLECTION_ROUTES_PATH=
ADLOG_RADIUS_REGISTRATION_CONTRACT_PATH=
ADLOG_RADIUS_CURSOR_BOOTSTRAP_EVIDENCE_PATH=
ADLOG_RADIUS_REGISTRATION_APPLY_EVIDENCE_PATH=
ADLOG_RADIUS_SOURCE_NAME=
ADLOG_RADIUS_SOURCE_INSTANCE_ID=
ADLOG_RADIUS_OWNER_CONFIRMED_IP=
ADLOG_RADIUS_ACCOUNTING_SHARE_UNC=
ADLOG_COLLECTION_PRINCIPAL=
ADLOG_COLLECTION_PRINCIPAL_SID=

# Raw event spool outside repository root (same drive) and automatic cleanup after hot-tier commit.
# Unified runtime data and spool directory outside repository root (same drive)
ADLOG_DATA_DIR=D:\sli_data
ADLOG_RAW_SPOOL_DIR=D:\sli_data\raw
ADLOG_TLS_CERT_PATH=D:\sli_data\certs\adlog-local-cert.pem
ADLOG_TLS_KEY_PATH=D:\sli_data\certs\adlog-local-key.pem
# By default, ADLOG_DELETE_IMPORTED_RAW is 1 (enabled). Set to 0 to keep raw logs for investigation.
ADLOG_DELETE_IMPORTED_RAW=1

# Storage V2 publication: scripts/runtime/storage_v2_outbox_worker.py is the
# sole production owner. scripts/run_dc_log_pilot.py's own compat-drain stays
# off unless ADLOG_ENABLE_INPROCESS_STORAGE_V2_DRAIN=1 is set explicitly
# (dev-only convenience for running without a separate durable worker
# process; never set it in production).
ADLOG_ENABLE_INPROCESS_STORAGE_V2_DRAIN=1
ADLOG_STORAGE_READ_MODE=v2
ADLOG_STORAGE_WRITE_MODE=v2
ADLOG_AI_EXECUTE_ENABLED=false
ADLOG_SEMANTIC_NORMALIZATION_ENABLED=false
ADLOG_SEMANTIC_ASSEMBLY_ENABLED=false
ADLOG_SEMANTIC_DIRECTORY_STATE_ENABLED=false
ADLOG_SEMANTIC_CORRELATION_ENABLED=false
ADLOG_SEMANTIC_RISK_ENGINE_ENABLED=false
ADLOG_SEMANTIC_FINDING_CREATION_ENABLED=false
OPENAI_API_KEY=
